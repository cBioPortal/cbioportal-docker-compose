{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cbioportal.org/schemas/wsi-stack-release-v2.json",
  "title": "Immutable cBioPortal WSI stack release",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "release_id",
    "created_at_utc",
    "components",
    "allowed_source_prefixes",
    "allowed_thumbnail_prefixes",
    "studies"
  ],
  "properties": {
    "version": {"const": 2},
    "release_id": {"type": "string", "minLength": 1},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frontend", "backend", "tile_server", "pdm", "clickhouse"],
      "properties": {
        "frontend": {"$ref": "#/$defs/frontend"},
        "backend": {"$ref": "#/$defs/imageComponent"},
        "tile_server": {"$ref": "#/$defs/imageComponent"},
        "pdm": {"$ref": "#/$defs/pdm"},
        "clickhouse": {"$ref": "#/$defs/clickhouse"}
      }
    },
    "allowed_source_prefixes": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 3,
      "items": {"enum": ["s3://pathology/", "s3://mskmind-bkt/", "s3://ocra/"]}
    },
    "allowed_thumbnail_prefixes": {
      "const": ["s3://mskmind-bkt/wsi-thumbnails/"]
    },
    "studies": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/study"}
    }
  },
  "$defs": {
    "gitSha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "frontend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git_sha", "artifact_url"],
      "properties": {
        "git_sha": {"$ref": "#/$defs/gitSha"},
        "artifact_url": {"type": "string", "format": "uri", "pattern": "^https://"}
      }
    },
    "imageComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git_sha", "image_digest"],
      "properties": {
        "git_sha": {"$ref": "#/$defs/gitSha"},
        "image_digest": {"type": "string", "pattern": "@sha256:[0-9a-fA-F]{64}$"}
      }
    },
    "pdm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git_sha", "contract_version", "databricks_job_run_id"],
      "properties": {
        "git_sha": {"$ref": "#/$defs/gitSha"},
        "contract_version": {"const": "wsi-serving-v2"},
        "databricks_job_run_id": {"type": "string", "minLength": 1}
      }
    },
    "clickhouse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "source_database"],
      "properties": {
        "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "source_database": {"type": "string", "minLength": 1}
      }
    },
    "study": {
      "type": "object",
      "additionalProperties": false,
      "required": ["study_id", "study_dir", "snapshot_manifest_sha256"],
      "properties": {
        "study_id": {"type": "string", "minLength": 1},
        "study_dir": {"type": "string", "minLength": 1},
        "timeline_dir": {"type": "string", "minLength": 1},
        "snapshot_manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
